{
  "name": "testengine",
  "version": "0.1.0",
  "description": "Isolated parallel web testing MCP server",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "testengine": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:build": "docker build --platform linux/arm64 -t testengine-browser docker/",
    "setup": "npm run docker:build && echo 'TestEngine setup complete'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "dockerode": "^4.0.4",
    "playwright": "1.52.0"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.31",
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
